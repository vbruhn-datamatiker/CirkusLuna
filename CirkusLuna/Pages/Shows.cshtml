@page
@model CirkusLuna.Pages.ShowsModel
@using CirkusLuna.ClassLibrary.Model
@{
}

<div class="container mt-4">

    <h1>Forestillinger</h1>

   

    <form method="get">
        @* the search form by city *@
        <div class="input-group mb-3">
            <input type="text" class="form-control"
                   name="SearchCity"
                   placeholder="Søg efter by..."
                   value="@Model.SearchCity" />
            <button class="btn btn-primary" type="submit">Søg</button>
        </div>

        <div class="mb-3">
            <label>Filtrer efter dato</label>
            <input type="date" class="form-control"
                   name="SearchDate"
                   value="@Model.SearchDate" />

                   
        </div>

        @* availability filter *@
        <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input"
                   name="OnlyAvailable"
                   value="true" />
            <label class="form-check-label">Vis kun forestillinger med ledige pladser</label>
        </div>
        <button class="btn btn-primary mb-3" type="submit">Filtrer</button>
    </form>

    @foreach (Show show in Model.Shows)
    {
   
        //show shows
        <div class="card mb-3">

            <div class="card-header">

                <h5>@show.ShowName</h5>

            </div>

            <div class="card-body">

                <p><strong>By:</strong> @show.City.Name</p>
                <p><strong>Dato:</strong> @show.Date</p>
                <p><strong>Ledige pladser:</strong> @show.Seats</p>
                <p><strong>VIP pladser:</strong> @show.VipSeats</p>
                <h6>Artister:</h6>

                @foreach (Artist artist in show.Artists)
                {
                    <span class="badge bg-primary">@artist.FullName - @artist.Act </span>
                }
               
            </div>

        </div>

        
    }

</div>
